Two-variable range loop: for i, v := range src { dst[i] = v * f }

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
package test

func ScalFloat32s(dst, src []float32, f float32) {
	for i, v := range src {
		dst[i] = v * f
	}
}

-- want.go --
//go:build goexperiment.simd

package test

import "simd"

func ScalFloat32s(dst, src []float32, f float32) {
	_vcFloat32s := simd.BroadcastFloat32s(f)
	for _i := 0; _i < len(dst); {
		_v1, _n := simd.LoadFloat32sPart(src[_i:])
		_v1.Mul(_vcFloat32s).StorePart(dst[_i:])
		_i += _n
	}
}

-- testmain/main.go --
package main

import (
	"fmt"

	"example.com/test"
)

func main() {
	src := []float32{1, 2, 3, 4}
	dst := make([]float32, len(src))
	test.ScalFloat32s(dst, src, 2.0)
	fmt.Println(dst)
}

-- testmain/output --
[2 4 6 8]
