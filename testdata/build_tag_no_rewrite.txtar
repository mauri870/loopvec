Files that already carry build constraints are left untouched.

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
//go:build linux

package test

func AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}

-- want.go --
//go:build linux

package test

func AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}
