Add element-wise float32 slices with a three-clause for loop.

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
package test

func AddFloat32s(dst, a, b []float32) {
	for i := 0; i < len(dst); i++ {
		dst[i] = a[i] + b[i]
	}
}

-- want.go --
//go:build goexperiment.simd

package test

import "simd"

func AddFloat32s(dst, a, b []float32) {
	for _i := 0; _i < len(dst); {
		_v1, _n := simd.LoadFloat32sPart(a[_i:])
		_v2, _ := simd.LoadFloat32sPart(b[_i:])
		_v1.Add(_v2).StorePart(dst[_i:])
		_i += _n
	}
}

-- testmain/main.go --
package main

import (
	"fmt"

	"example.com/test"
)

func main() {
	dst := make([]float32, 5)
	a := []float32{1.5, 2.5, 3.5, 4.5, 5.5}
	b := []float32{10.0, 20.0, 30.0, 40.0, 50.0}
	test.AddFloat32s(dst, a, b)
	fmt.Println(dst)
}

-- testmain/output --
[11.5 22.5 33.5 44.5 55.5]
