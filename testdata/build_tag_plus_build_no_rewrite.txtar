Legacy // +build constraints also cause the file to be skipped.

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
// +build linux

package test

func AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}

-- want.go --
// +build linux

package test

func AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}
