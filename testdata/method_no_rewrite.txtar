Methods are not rewritten due to golang/go#80657 (simd compiler bug with receiver functions).

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
package test

type T struct{}

func (T) AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}

-- want.go --
package test

type T struct{}

func (T) AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}
