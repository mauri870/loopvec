Add element-wise int32 slices with a range loop.

-- go.mod --
module example.com/test

go 1.27.1

-- in.go --
package test

func AddInt32s(dst, a, b []int32) {
	for i := range dst {
		dst[i] = a[i] + b[i]
	}
}

-- want.go --
//go:build goexperiment.simd

package test

import "simd"

func AddInt32s(dst, a, b []int32) {
	for _i := 0; _i < len(dst); {
		_v1, _n := simd.LoadInt32sPart(a[_i:])
		_v2, _ := simd.LoadInt32sPart(b[_i:])
		_v1.Add(_v2).StorePart(dst[_i:])
		_i += _n
	}
}

-- testmain/main.go --
package main

import (
	"fmt"

	"example.com/test"
)

func main() {
	dst := make([]int32, 8)
	a := []int32{1, 2, 3, 4, 5, 6, 7, 8}
	b := []int32{10, 20, 30, 40, 50, 60, 70, 80}
	test.AddInt32s(dst, a, b)
	fmt.Println(dst)
}

-- testmain/output --
[11 22 33 44 55 66 77 88]
